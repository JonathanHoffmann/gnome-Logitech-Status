    "version": "2.0.0",
    "tasks": [
        {
            "label": "deploy",
            "type": "shell",
            "command": [
                "cp * /home/jonathan/.local/share/gnome-shell/extensions/gnome-logitech-status@ju.wtf/.",
                "gnome-extensions disable gnome-logitech-status@ju.wtf",
                "gnome-extensions enable gnome-logitech-status@ju.wtf"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
        }
    ]
}
